# Server-only secrets. NEVER commit this file, NEVER use these keys in the browser.
# Start with test keys (sk_test_...). Switch to live keys only when ready.
PORT=25609
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# SendPulse SMTP API key for stock-alert emails (server uses it directly;
# never put it in frontend code or git). Empty = direct port-25 delivery.
SENDPULSE_API_KEY=
# Verified sender for the SendPulse API. Must be verified on your SendPulse
# account (SMTP settings) or sends fail with 422. (New accounts start on an
# SMTP Test plan whose pre-verified devtest@sendpulseemail.com also works —
# use that address only while on the Test plan.)
SENDPULSE_API_FROM_EMAIL=sender@sourcedbysmz.co.uk
# Optional display name for the sender. Defaults to SOURCEDBYSMZ.
SENDPULSE_API_FROM_NAME=
# Optional API base override. Defaults to https://api.sendpulse.com.
SENDPULSE_API_BASE_URL=
# Comma-separated origins allowed to call this API.
FRONTEND_URLS=http://localhost:5173,http://localhost:4173
# Outgoing mail from your own domain (stock alerts). Empty = direct delivery
# on port 25 (needs the host to allow outbound SMTP). Or set a relay:
# SMTP_URL=smtp://user:pass@relay-host:587
MAIL_FROM_DOMAIN=sourcedbysmz.co.uk
PUBLIC_SHOP_URL=https://sourcedbysmz.co.uk
